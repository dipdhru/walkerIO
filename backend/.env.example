# Walker.IO Backend — Environment Variables
# Copy to .env and fill in real values

NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://walkerio:password@localhost:5432/walkerio
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# Auth — use a 32+ character random string
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In
APPLE_CLIENT_ID=com.walkerio.app
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Anti-cheat
MAX_SPEED_KMH=50
MAX_VIOLATIONS_PER_SESSION=3

# GPS Batching
GPS_BATCH_INTERVAL_MS=3000
GPS_MIN_DISTANCE_METERS=10
GPS_MAX_BATCH_SIZE=50

# Territory
MIN_POLYGON_AREA_M2=100
MAX_SESSION_AREA_M2=10000000

# CORS
CORS_ORIGINS=http://localhost:8081,https://walkerio.app
